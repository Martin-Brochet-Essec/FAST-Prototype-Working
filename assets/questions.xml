      <other label="Autre, précisez"/>
    </question>

    <question type="single_choice" required="true">
      <text>Depuis combien de temps occupez-vous votre poste actuel ?</text>
      <options>
        <option>0-11 mois</option>
        <option>1-2 ans</option>
        <option>3-5 ans</option>
        <option>6-10 ans</option>
        <option>11-20 ans</option>
        <option>20 ans et +</option>
      </options>
      <other label="Autre, précisez"/>
    </question>

    <question type="multi_choice" required="true" min="1" max="3">
      <text>Quel objectif de carrière visez-vous dans les 12 prochains mois ?</text>
      <options>
        <option>Obtenir une promotion</option>
        <option>Évoluer vers un poste de direction</option>
        <option>Changer de poste ou d'entreprise</option>
        <option>Élargir mon réseau professionnel</option>
        <option>Développer de nouvelles compétences</option>
      </options>
      <other label="Autre, précisez"/>
    </question>

    <question type="multi_choice" required="true" min="1" max="3">
      <text>Qu'est-ce qui vous semble le plus difficile à obtenir ?</text>
      <options>
        <option>Reconnaissance salariale</option>
        <option>Promotion</option>
        <option>Équilibre vie pro/perso</option>
        <option>Confiance en vous</option>
      </options>
      <other label="Autre, précisez"/>
    </question>

    <question type="multi_choice" required="true" min="1">
      <text>Avez-vous des proches dont vous avez la charge au quotidien ?</text>
      <options>
        <option exclusive="true">Aucun</option>
        <option>Enfant(s)</option>
        <option>Conjoint(e)</option>
        <option>Parents</option>
      </options>
      <other label="Autre, précisez"/>
    </question>

    <question type="scale" required="true">
      <text>Comment décririez-vous le soutien de votre entourage dans votre vie professionnelle ?</text>
      <scale min="-3" max="3">
        <label value="-3">Ennemi</label>
        <label value="-2">Me décourage</label>
        <label value="-1">Ne m'écoute pas</label>
        <label value="0">Neutre</label>
        <label value="1">Supporter</label>
        <label value="2">De grand conseil</label>
        <label value="3">Ils se sacrifient pour moi</label>
      </scale>
      <remark label="Remarque, précisez" required="false"/>
    </question>

