<questions>
  <set id="q10" lang="fr">

    <question type="single_choice" required="true">
      <text>Quel est votre secteur d'activité aujourd'hui ?</text>
      <options>
        <option>Tech / IT</option>
        <option>Finance</option>
        <option>Santé</option>
        <option>Industrie</option>
        <option>Retail</option>
        <option>Éducation</option>
        <option>Conseil</option>
        <option>Droit</option>
        <option>Média</option>
