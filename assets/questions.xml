      <text>Votre manager vous donne-t-il de la visibilité sur des projets stratégiques ?</text>
      <options>
        <option>Aucune visibilité</option>
        <option>Informée après coup</option>
        <option>Consultée ponctuellement</option>
        <option>Impliquée dans les décisions</option>
        <option>Pilote de projets stratégiques</option>
      </options>
      <other label="Autre, précisez"/>
    </question>

